<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 3 Stage A part Д5 — Auto Backup от Android (legacy для Android 11 и ниже).

  Что бэкапим автоматически в Google аккаунт пользователя:
    - sharedpref/* (DataStore Preferences: user_profile, app_settings,
      trainer_progress, favorites, accent_errors, word_blank_errors)
    - database/* (Room — solutions, problems metadata)

  Что НЕ бэкапим (исключения):
    - database/corpus.db — БД задач 192 MB, поставляется с APK
      (ROM пакеты Android накладывают лимит ~25 MB на Auto Backup).
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <exclude domain="database" path="corpus.db" />
</full-backup-content>
