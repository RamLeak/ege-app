<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 3 Stage A part Д5 — Android 12+ data extraction rules.

  Два домена:
    - cloud-backup: ежедневный бэкап в Google аккаунт.
    - device-transfer: перенос на новое устройство (когда пользователь меняет
      телефон или восстанавливает с Samsung Smart Switch).

  Для обоих — sharedpref + database, исключение corpus.db.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="database" path="corpus.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <exclude domain="database" path="corpus.db" />
    </device-transfer>
</data-extraction-rules>
