android/_build_*.bat
# Phase 4 Stage P4-D — временные batch-файлы для pre-gen.
parser/_batch_*.json
parser/_b*.json
parser/_all_words.json
parser/_wb_all.json
parser/.processing.lock
# Phase 4 Stage P4-D4 — drafts от build_grammar_v2.py (заполняются inline).
parser/data/grammar_errors_draft.json
*.apk
*.aab
*.keystore

# corpus.db в android/app/src/main/assets — это копия parser/corpus.db (192 MB).
# В git хранится только в parser/; на стороне Android — скопировать локально
# перед сборкой (см. README/CLAUDE.md).
android/app/src/main/assets/corpus.db
# accent_words.json — исходник в корне проекта; копия в assets/ gitignored.
android/app/src/main/assets/accent_words.json
# word_blanks.json — исходник в parser/word_blanks.json; копия в assets/ gitignored.
android/app/src/main/assets/word_blanks.json
# rules.json — исходник в parser/rules.json (генерится generate_rules.py); копия в assets/ gitignored.
android/app/src/main/assets/rules.json
# quotes.json — исходник в parser/quotes.json (генерится generate_quotes.py); копия в assets/ gitignored.
android/app/src/main/assets/quotes.json
# fipi_variants.json — исходник в parser/fipi_variants.json (генерится parse_fipi_variants.py); копия в assets/ gitignored.
android/app/src/main/assets/fipi_variants.json
# Phase 4 Stage P4-D — исходники в parser/data/ (генерится extract_*.py); копии в assets/ gitignored.
android/app/src/main/assets/paronyms.json
android/app/src/main/assets/pleonasms.json
android/app/src/main/assets/grammar_errors.json
android/app/src/main/assets/trig_values.json
android/app/src/main/assets/short_multiplication_formulas.json
android/app/src/main/assets/log_power_properties.json
android/app/src/main/assets/derivatives.json
android/app/src/main/assets/geometric_formulas.json

# Secrets
.env
.env.local
*.secret

# Claude Code — локальные настройки/permissions конкретной машины не коммитим.
# Если когда-нибудь появится shared конфигурация — она пойдёт в .claude/settings.json.
.claude/settings.local.json

# Recon archive — старые ФИПИ-эксперименты не нужны в git
parser/fipi-recon-archive/

