# corpus.db в android/app/src/main/assets — это копия parser/corpus.db (192 MB).
# В git хранится только в parser/; на стороне Android — скопировать локально
# перед сборкой (см. README/CLAUDE.md).
android/app/src/main/assets/corpus.db
# accent_words.json — исходник в корне проекта; копия в assets/ gitignored.
android/app/src/main/assets/accent_words.json
# word_blanks.json — исходник в parser/word_blanks.json; копия в assets/ gitignored.
android/app/src/main/assets/word_blanks.json
# rules.json — исходник в parser/rules.json (генерится generate_rules.py); копия в assets/ gitignored.
android/app/src/main/assets/rules.json

# Secrets
.env
.env.local
*.secret

# Claude Code — локальные настройки/permissions конкретной машины не коммитим.
# Если когда-нибудь появится shared конфигурация — она пойдёт в .claude/settings.json.
.claude/settings.local.json

# Recon archive — старые ФИПИ-эксперименты не нужны в git
parser/fipi-recon-archive/

# Большие сырые HTML архивы — оставляем recon-sdamgia/ для дебага, но если разрастётся:
# parser/recon-sdamgia/  # раскомментируй если папка станет >5 МБ